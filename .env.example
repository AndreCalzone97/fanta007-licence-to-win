FANTA007_DATASET_PATH=data/normalized/players.json
FANTA007_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FANTA007_MEDIA_REVIEW_PATH=data/manual/player_media_reviews.json
# Local/trusted review only: only true enables mutations (default: false).
FANTA007_ENABLE_MEDIA_REVIEW_ADMIN=false
FANTA007_TEAM_CATALOG_PATH=data/manual/teams.2026-27.json
# Optional server-side token for the Home Serie A rail. Never expose as VITE_*.
# Without it, the rail displays clearly labeled illustrative data.
# API_FOOTBALL_KEY=your-api-football-key
# Optional: API_FOOTBALL_SEASON=2026
# Leave unset locally: Vite proxies /api to the backend on port 8000.
# Set an explicit public API URL only for a separately hosted production API.
# VITE_API_BASE_URL=https://your-api.example/api/v1
